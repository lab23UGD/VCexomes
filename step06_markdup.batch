#!/bin/bash
#SBATCH --job-name=VCx_s06_markdup
#SBATCH --qos=short
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=10gb
#SBATCH --time=1-00:00:00
#
# VCexomes step 06 | coordinate sorting and duplicate removal
# Sorts the merged BAM by coordinate (Picard SortSam), removes the duplicate
# reads arising from PCR (Picard MarkDuplicates with REMOVE_DUPLICATES=true)
# and indexes the result. One array task per sample.
#
# Usage: sbatch --array=0-N scripts/step06_markdup.batch config/fisdm4.cfg
# Author: Celeste Moya-Valera (cmoya@incliva.es)

set -euo pipefail

repo_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../src/common.sh
source "${repo_dir}/src/common.sh"
load_config "${1:-}"

module load "$modules_biotools"

task=$(array_task_id)
bam_path=$(fof_line "$bam_merged_fof" "$task")
bam_dir=$(dirname "$bam_path")
sample=$(basename "$bam_path" _merged_files.bam)

metrics_dir="${bam_dir}/${sample}"
status_dir="${metrics_dir}/_status"
sorted_bam="${bam_dir}/${sample}_rgmod.merged.sort.bam"
rmdp_bam="${bam_dir}/${sample}_rgmod.merged.sort.rmdp.bam"

step_header "Step 06 | Duplicate removal | sample ${sample}"
log_info "Input BAM:  ${bam_path}"
log_info "Output BAM: ${rmdp_bam}"

if skip_if_done "$rmdp_bam" "Deduplicated BAM already exists for ${sample}, skipping."; then
    exit 0
fi

require_file "$bam_path"
require_file "$picard_jar"
make_sample_dirs "$metrics_dir"

mark_status "$status_dir" START "SortSam_${sample}"
log_info "Sorting by coordinate"
java -jar "$picard_jar" SortSam \
    --INPUT "$bam_path" \
    --OUTPUT "$sorted_bam" \
    --SORT_ORDER coordinate \
    --VALIDATION_STRINGENCY SILENT \
    2> "${metrics_dir}/logs/${sample}.SortSam.err" \
    1> "${metrics_dir}/logs/${sample}.SortSam.out"
mark_status "$status_dir" DONE "SortSam_${sample}"

mark_status "$status_dir" START "MarkDuplicates_${sample}"
log_info "Removing PCR duplicates"
java -jar "$picard_jar" MarkDuplicates \
    --INPUT "$sorted_bam" \
    --OUTPUT "$rmdp_bam" \
    --METRICS_FILE "${metrics_dir}/metrics/${sample}_rgmod.merged.sort.rmdp.metrics.txt" \
    --REMOVE_DUPLICATES true \
    --CREATE_INDEX true \
    --VALIDATION_STRINGENCY SILENT \
    2> "${metrics_dir}/logs/${sample}.markDup.err" \
    1> "${metrics_dir}/logs/${sample}.markDup.out"
mark_status "$status_dir" DONE "MarkDuplicates_${sample}"

log_info "Indexing the deduplicated BAM"
samtools index "$rmdp_bam"

log_info "DONE step 06 for sample ${sample}"
